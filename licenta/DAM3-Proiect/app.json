{
  "expo": {
    "name": "Local Utility Suite",
    "slug": "dam-utility-suite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "utilitysuite",
    "splash": {
      "backgroundColor": "#090d16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.ucv.feaa.dam.utilitysuite"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090d16"
      },
      "package": "ro.ucv.feaa.dam.utilitysuite",
      "permissions": [
        "CAMERA",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "FLASHLIGHT",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permisiune necesara pentru scanarea documentelor si functionalitatea de lanterna."
        }
      ]
    ]
  }
}
